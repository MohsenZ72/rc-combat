{
  "name": "rc-combat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/game-core",
    "apps/api",
    "apps/game-server",
    "apps/client"
  ],
  "scripts": {
    "build:packages": "npm run build -w @rc/shared -w @rc/game-core",
    "build": "npm run build:packages && npm run build -w @rc/api -w @rc/game-server -w @rc/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:up": "bash scripts/db-up.sh",
    "db:migrate": "npm run migrate -w @rc/api",
    "dev": "npm run build:packages && concurrently -k -n api,game,client -c blue,magenta,green \"npm run dev -w @rc/api\" \"npm run dev -w @rc/game-server\" \"npm run dev -w @rc/client\"",
    "loadtest": "npm run loadtest -w @rc/game-server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
