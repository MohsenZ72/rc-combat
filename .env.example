# Copy to .env and replace every CHANGE_ME. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info

# ---- Postgres (docker compose maps it to localhost:5433)
POSTGRES_USER=rc
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=rc_combat
POSTGRES_PORT=5433
DATABASE_URL=postgres://rc:CHANGE_ME_db_password@localhost:5433/rc_combat

# ---- Shared secrets (generate with: openssl rand -hex 32)
# Signs player access tokens; API and game server must share it.
JWT_SECRET=CHANGE_ME_at_least_32_chars
JWT_ISSUER=rc-combat-api
JWT_AUDIENCE=rc-combat
JWT_TTL_SECONDS=43200
# Game server -> API /internal routes. Keep these routes off the public internet.
INTERNAL_API_KEY=CHANGE_ME_at_least_24_chars

# ---- API
API_PORT=3000
CLIENT_ORIGINS=http://localhost:5173
SUSPENSION_HOURS=24
RATE_LIMIT_PER_MINUTE=120
GUEST_LOGINS_PER_MINUTE=10

# ---- Game server
GAME_SERVER_PORT=2567
GAME_SERVER_ID=local-1
API_INTERNAL_URL=http://localhost:3000
TICK_RATE=30
SNAPSHOT_DIVISOR=1
MIN_PLAYERS=1
MAX_PLAYERS=10
LOBBY_WAIT_SECONDS=15
# Casual/dev only: fill empty seats with bots. Bot matches are never prize-eligible.
FILL_WITH_BOTS=true
RECONNECT_SECONDS=20
RESULTS_LINGER_SECONDS=45

# ---- Client (Vite exposes only VITE_* to the browser; nothing secret here)
VITE_API_URL=http://localhost:3000
VITE_GAME_SERVER_URL=ws://localhost:2567
