{
  "name": "@rc/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "loadtest": "tsx --conditions=source --env-file-if-exists=../../.env scripts/loadtest.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.45",
    "@colyseus/sdk": "^0.18.9",
    "@rc/game-core": "0.1.0",
    "@rc/shared": "0.1.0",
    "colyseus": "^0.18.12",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@types/node": "^24.19.2",
    "vitest": "^5.1.0"
  }
}
